{
  "manifest_version": 3,
  "name": "Drive Folder Copier Lite",
  "version": "0.1.0",
  "key": "",
  "description": "Copy specific Google Drive files into your My Drive. Select as many as you like at once — no verification wait, no restricted permissions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "identity",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://drive-folder-copier-backend.vercel.app/*"
  ],
  "externally_connectable": {
    "matches": ["https://reyesnes.github.io/*", "https://extensionlabs.online/*"]
  }
}
